            },
            "description": "Solo el organizer dueño del evento o un admin. Devuelve el resumen de cupo y la lista de inscriptos."
          }
        },
        {
          "name": "16 · Listado paginado (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const p = pm.response.json().payload;",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('estructura paginada', () => pm.expect(p).to.have.all.keys('data', 'page', 'limit', 'total', 'totalPages'));",
                  "pm.test('page y limit respetados', () => {",
                  "  pm.expect(p.page).to.eql(2);",
                  "  pm.expect(p.limit).to.eql(5);",
                  "});",
                  "pm.test('totalPages coherente', () => pm.expect(p.totalPages).to.eql(Math.ceil(p.total / p.limit)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/events?status=published&page=2&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "published"
                },
                {
                  "key": "page",
                  "value": "2"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Si hay menos de 6 eventos publicados, `data` viene vacío pero la estructura es la misma. Creá más eventos para ver la segunda página con contenido."
          }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "POST /sessions/register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
