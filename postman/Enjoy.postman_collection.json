    {
      "name": "Events",
      "item": [
        {
          "name": "GET /events (filtros, paginación y orden)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/events?status=published&category=workshop&location=Centro&dateFrom=2027-03-01&dateTo=2027-03-31&page=1&limit=10&sort=date",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "published",
                  "description": "published | cancelled | finished (los draft no se listan)"
                },
                {
                  "key": "category",
                  "value": "workshop",
                  "description": "clase | workshop | torneo | actividad"
                },
                {
                  "key": "location",
                  "value": "Centro",
                  "description": "Coincidencia parcial, sin distinguir mayúsculas"
                },
                {
                  "key": "dateFrom",
                  "value": "2027-03-01"
                },
                {
                  "key": "dateTo",
                  "value": "2027-03-31",
                  "description": "Si es solo fecha, incluye todo el día"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Entre 1 y 50"
                },
                {
                  "key": "sort",
                  "value": "date",
                  "description": "date | price | capacity | title | createdAt. Prefijo '-' para descendente"
                }
              ]
            },
            "description": "Público. Devuelve `{ data, page, limit, total, totalPages }`. Todos los parámetros son opcionales; por defecto lista los publicados ordenados por fecha ascendente, 10 por página."
          }
        },
        {
          "name": "GET /events/:id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}"
              ]
            },
            "description": "Público. 400 si el id no es un ObjectId válido, 404 si no existe o está en `draft`."
          }
        },
        {
          "name": "POST /events 🔒 organizer/admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Workshop de movilidad\",\n  \"description\": \"Trabajo de movilidad articular y respiración\",\n  \"category\": \"workshop\",\n  \"date\": \"2027-03-15T18:00:00.000Z\",\n  \"location\": \"Sede Centro\",\n  \"capacity\": 20,\n  \"price\": 0,\n  \"status\": \"published\"\n}"
            },
            "description": "`status` es opcional y solo acepta `draft` o `published` (por defecto `published`). 400 si la fecha es pasada, `capacity` no es entero > 0 o `price` es negativo. 401 sin sesión, 403 como `user`."
          }
        },
        {
          "name": "PUT /events/:id 🔒 dueño/admin",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Workshop de movilidad (actualizado)\",\n  \"capacity\": 25\n}"
            },
            "description": "Actualización parcial de los campos editables. 400 si no viene ningún campo válido, 403 si el evento es ajeno, 409 si el evento está cancelado. El `status` no se cambia por acá."
          }
        },
        {
          "name": "PATCH /events/:id/status 🔒 dueño/admin",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"cancelled\"\n}"
            },
            "description": "Transiciones válidas: draft → published/cancelled · published → draft/cancelled/finished. `cancelled` y `finished` son terminales: cualquier cambio desde ahí responde 409."
          }
        }
      ]
    },
