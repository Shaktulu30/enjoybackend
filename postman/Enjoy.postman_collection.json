          }
        },
        {
          "name": "PATCH /tickets/:tid/cancel 🔒 dueño/admin",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/cancel",
